# Copy this file to .env.local and fill in your values

# Supabase — get these from your Supabase project settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SB_PUBLISHABLE_KEY=your_supabase_anon_key_here
VITE_ATTACHMENTS_BUCKET=attachments

# Anthropic API — required for Reply Analyzer and Call Script Engine tabs
# Get your key at: https://console.anthropic.com/
# NOTE: In production, proxy this through a backend to avoid exposing the key.
# For internal-only use (Amanda/Monica/Marlon), direct browser access is acceptable.
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Google Workplace SSO domain
# VITE_GOOGLE_WORKPLACE_DOMAIN=yourdomain.com

# Optional: Disable email/password login (set to "true" if using SSO only)
# VITE_DISABLE_EMAIL_PASSWORD_AUTHENTICATION=false
